  "components": [
    {
      "name": "Action Button",
      "kind": "button",
      "refersTo": "button-action",
      "description": "The one primary action per view.",
      "html": "<button class=\"ds-btn ds-btn-action\">Stage 2 new</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:0 18px;border:0;border-radius:0;cursor:pointer;font-family:var(--font-display,'Saira Condensed',sans-serif);font-weight:800;font-size:16px;letter-spacing:0.04em;text-transform:uppercase;transition:filter .15s ease,transform .1s ease}.ds-btn:hover{filter:brightness(1.06)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:3px solid var(--action,#ffd100);outline-offset:2px}.ds-btn-action{background:var(--action,#ffd100);color:var(--action-ink,#1a1030)}"
    },
    {
      "name": "Line Button",
      "kind": "button",
      "refersTo": "button-line",
      "description": "Secondary actions: Sync now, Copy, Download.",
      "html": "<button class=\"ds-btn-line\">Sync now</button>",
      "css": ".ds-btn-line{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:0 18px;border-radius:0;cursor:pointer;font-family:var(--font-display,'Saira Condensed',sans-serif);font-weight:800;font-size:16px;letter-spacing:0.04em;text-transform:uppercase;background:transparent;color:var(--ink,#1a1030);border:1px solid var(--field-rule,#cfc7de);transition:filter .15s ease,transform .1s ease}.ds-btn-line:hover{filter:brightness(1.06)}.ds-btn-line:active{transform:translateY(1px)}.ds-btn-line:focus-visible{outline:3px solid var(--action,#ffd100);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Labelled field with 2px radius and yellow focus ring.",
      "html": "<div class=\"ds-field\"><label for=\"ds-q\">Google Sheet link</label><input id=\"ds-q\" placeholder=\"https://docs.google.com/spreadsheets/d/…\"></div>",
      "css": ".ds-field{display:grid;gap:6px;font-family:var(--font-body,Saira,sans-serif);font-size:14px;color:var(--ink,#1a1030)}.ds-field label{font-weight:600;font-size:13px}.ds-field input{background:var(--field,#fff);border:1px solid var(--field-rule,#cfc7de);border-radius:2px;padding:9px 11px;min-height:40px;font:inherit;color:inherit}.ds-field input::placeholder{color:var(--muted,#5c5170)}.ds-field input:focus-visible{outline:3px solid var(--action,#ffd100);outline-offset:2px}"
    },
    {
      "name": "Filter Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Source and result filters; selected fills with the shell colour.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\" aria-pressed=\"true\">Paste</button><button class=\"ds-chip\" aria-pressed=\"false\">New <b>4</b></button></div>",
      "css": ".ds-chips{display:flex;gap:10px}.ds-chip{background:var(--chip,#f1edf8);color:var(--ink,#1a1030);border:1px solid transparent;border-radius:0;padding:5px 11px;cursor:pointer;font-family:var(--font-body,Saira,sans-serif);font-weight:600;font-size:13px}.ds-chip b{font-weight:800;margin-left:4px}.ds-chip[aria-pressed=true]{background:var(--shell,#3b0a78);color:var(--shell-ink,#fff)}.ds-chip:focus-visible{outline:3px solid var(--action,#ffd100);outline-offset:2px}"
    },
    {
      "name": "Shell Nav",
      "kind": "nav",
      "refersTo": "topbar",
      "description": "Sticky broadcast bar with brand, links and yellow active underline.",
      "html": "<header class=\"ds-top\"><a class=\"ds-brand\" href=\"#\">Investor Hub</a><nav class=\"ds-nav\"><a href=\"#\" aria-current=\"page\">Overview</a><a href=\"#\">Check a list</a><a href=\"#\">Campaigns</a><a href=\"#\">Pipeline</a></nav></header>",
      "css": ".ds-top{background:var(--shell,#3b0a78);color:var(--shell-ink,#fff);display:flex;align-items:center;gap:28px;height:56px;padding:0 28px;font-family:var(--font-body,Saira,sans-serif);font-size:14px}.ds-brand{font-family:var(--font-display,'Saira Condensed',sans-serif);font-weight:800;font-size:20px;letter-spacing:0.03em;text-transform:uppercase;color:inherit;text-decoration:none}.ds-nav{display:flex;gap:22px;height:100%}.ds-nav a{display:flex;align-items:center;color:var(--shell-muted,#d8c9f2);text-decoration:none;font-weight:600;box-shadow:inset 0 -3px 0 transparent;transition:color .15s ease,box-shadow .2s ease}.ds-nav a:hover{color:var(--shell-ink,#fff)}.ds-nav a[aria-current=page]{color:var(--shell-ink,#fff);box-shadow:inset 0 -3px 0 var(--action,#ffd100)}.ds-nav a:focus-visible{outline:3px solid var(--action,#ffd100);outline-offset:2px}"
    },
    {
      "name": "Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat square panel with title and muted subtitle on a shared baseline.",
      "html": "<section class=\"ds-panel\"><div class=\"ds-ph\"><h2>Follow-ups due</h2><span>0 today · 3 overdue</span></div><p>Jitesh Agrawal · Saflex · <span class=\"ds-late\">28 days late</span></p></section>",
      "css": ".ds-panel{background:var(--panel,#fff);border:1px solid var(--rule,#ece8f3);padding:18px;color:var(--ink,#1a1030);font-family:var(--font-body,Saira,sans-serif);font-size:14px;font-variant-numeric:tabular-nums}.ds-ph{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:10px}.ds-ph h2{margin:0;font-family:var(--font-display,'Saira Condensed',sans-serif);font-weight:800;font-size:20px;text-transform:uppercase;letter-spacing:0.03em}.ds-ph span{color:var(--muted,#5c5170);font-size:13px}.ds-panel p{margin:0}.ds-late{color:var(--late,#b4005c);font-weight:600}"
    },
    {
      "name": "Score Bug",
      "kind": "custom",
      "refersTo": "score-bug",
      "description": "Signature full-width chase summary on every screen.",
      "html": "<section class=\"ds-bug\"><div class=\"ds-bat\"><small>Week 45 · contacted</small><b>312/500</b></div><div class=\"ds-need\">Need<em>188</em>from 4 days</div><div class=\"ds-stat\"><small>Current rate</small><b>78/day</b></div><div class=\"ds-stat\"><small>Required rate</small><b class=\"ds-proj\">47/day</b></div><div class=\"ds-stat\"><small>Reply rate</small><b>4.2%</b></div></section>",
      "css": ".ds-bug{display:grid;grid-template-columns:auto 1fr repeat(3,auto);background:var(--bug,#1a1030);color:var(--bug-ink,#fff);min-height:88px;font-family:var(--font-body,Saira,sans-serif);font-variant-numeric:tabular-nums}.ds-bat{background:var(--bat,#e6007e);color:var(--bat-ink,#fff);padding:10px 26px;display:flex;flex-direction:column;justify-content:center}.ds-bat small{font-weight:600;font-size:13px}.ds-bat b{font-family:var(--font-display,'Saira Condensed',sans-serif);font-weight:800;font-size:46px;line-height:1;letter-spacing:0.01em}.ds-need{padding:10px 26px;display:flex;align-items:center;font-family:var(--font-display,'Saira Condensed',sans-serif);font-weight:700;font-size:26px;text-transform:uppercase;letter-spacing:0.02em}.ds-need em{font-style:normal;color:var(--action,#ffd100);margin:0 9px}.ds-stat{padding:10px 22px;border-left:1px solid var(--bug-rule,#3a2e55);display:flex;flex-direction:column;justify-content:center}.ds-stat small{color:var(--bug-muted,#b8aecf);font-size:12px;text-transform:uppercase;letter-spacing:0.06em}.ds-stat b{font-family:var(--font-display,'Saira Condensed',sans-serif);font-weight:800;font-size:30px;line-height:1.1}.ds-proj{color:var(--proj,#00b3e6)}"
    },
    {
      "name": "Results Tally",
      "kind": "custom",
      "refersTo": "score-bug",
      "description": "List scorecard after a check; first cell in the batting colour.",
      "html": "<div class=\"ds-tally\"><div><small>New</small><b>2</b></div><div><small>Already contacted</small><b>1</b></div><div><small>Do not contact</small><b>2</b></div><div><small>Bounced / unsub</small><b>0</b></div><div><small>Already staged</small><b>0</b></div><div><small>Repeated in list</small><b>1</b></div></div>",
      "css": ".ds-tally{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));background:var(--bug,#1a1030);color:var(--bug-ink,#fff);font-family:var(--font-body,Saira,sans-serif)}.ds-tally div{padding:12px 16px;border-left:1px solid var(--bug-rule,#3a2e55)}.ds-tally div:first-child{background:var(--bat,#e6007e);color:var(--bat-ink,#fff);border:0}.ds-tally small{display:block;font-size:12px;text-transform:uppercase;letter-spacing:0.06em;opacity:.85}.ds-tally b{font-family:var(--font-display,'Saira Condensed',sans-serif);font-weight:800;font-size:32px;line-height:1.1}"
    },
    {
      "name": "Check Plate",
      "kind": "custom",
      "refersTo": "check-plate",
      "description": "The yellow action plate pairing reassurance with the check button.",
      "html": "<div class=\"ds-plate\"><p>Nothing is marked as used until YAMM merges it.</p><button class=\"ds-pbtn\">Check list</button></div>",
      "css": ".ds-plate{display:flex;background:var(--action,#ffd100);color:var(--action-ink,#1a1030);font-family:var(--font-body,Saira,sans-serif);font-size:14px}.ds-plate p{flex:1;margin:0;padding:14px 16px}.ds-pbtn{background:var(--bug,#1a1030);color:var(--action,#ffd100);border:0;padding:0 18px;cursor:pointer;font-family:var(--font-display,'Saira Condensed',sans-serif);font-weight:800;font-size:16px;letter-spacing:0.04em;text-transform:uppercase;transition:filter .15s ease}.ds-pbtn:hover{filter:brightness(1.06)}.ds-pbtn:focus-visible{outline:3px solid var(--action,#ffd100);outline-offset:2px}"
    },
    {
      "name": "Status Badge",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Outlined status tag; dot shape doubles the colour cue.",
      "html": "<span class=\"ds-badge ds-new\">New</span> <span class=\"ds-badge ds-dnc\">Do not contact</span> <span class=\"ds-badge ds-warn\">Staged</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:6px;font-family:var(--font-body,Saira,sans-serif);font-size:12px;font-weight:600;padding:2px 8px;border:1px solid currentColor}.ds-badge::before{content:'';width:7px;height:7px;border-radius:50%;background:currentColor}.ds-new{color:var(--ok,#0c7a4f)}.ds-new::before{border-radius:0}.ds-dnc{color:var(--late,#b4005c)}.ds-dnc::before{background:transparent;border:2px solid currentColor;width:5px;height:5px}.ds-warn{color:var(--warn,#9a5b00)}"
    }
  ],
  "narrative": {
    "northStar": "The Run Chase",
    "overview": "The hub reads like an IPL broadcast overlay laid over a working tool. A saturated shell bar sits on top like the channel strip, a dark score bug spans the full width beneath it on every screen, and everything below is flat panels on a pale ground. The bug states the chase in one line (contacted against target, \"Need N from D days\", current rate against required rate, reply rate), and every other surface is a supporting scorecard: tallies, worm chart, bars per batter.\n\nDensity is operational: 14px body with tabular figures throughout, tight 18px panel padding, tables with ruled rows. Character comes from colour blocks and condensed uppercase numbers, not from depth, curves or ornament. The broadcast palette (shell, batting block, projection, action) is one of four interchangeable kits (purple, blue, green, red), each in light, dark, or system mode, swapped through custom properties on the root; components never name a team colour directly.\n\nThe world refuses the category default of same-size KPI cards over a line chart: headline figures live in the bug or a tally strip, never in a grid of floating cards.",
    "keyCharacteristics": [
      "Full-bleed shell bar plus full-width score bug on every authenticated screen.",
      "Flat panels, square corners, hairline rules; one shadow in the whole system, on the floating theme popover.",
      "Saira Condensed 800 uppercase for every figure, heading and button; Saira for running text; tabular numerals everywhere.",
      "Colour by role through tokens, so the four team kits and dark mode swap without touching components."
    ],
    "rules": [
      {
        "name": "The Kit Swap Rule",
        "body": "Components reference roles (shell, bat, proj, action, bug), never a hex. A new surface must render correctly in all four kits and both modes without a single kit-specific override.",
        "section": "colors"
      },
      {
        "name": "The One Plate Rule",
        "body": "Action Yellow fills at most one control or plate per view. Secondary actions are line or dark buttons.",
        "section": "colors"
      },
      {
        "name": "The Ink Pairing Rule",
        "body": "Every role colour travels with its own ink token (shell-ink, bat-ink, action-ink). Blue and red kits use a dark bat-ink on orange; never assume white on bat.",
        "section": "colors"
      },
      {
        "name": "The Tabular Everything Rule",
        "body": "`font-variant-numeric: tabular-nums` is set on the body; every figure lines up in columns and rolls without jitter.",
        "section": "typography"
      },
      {
        "name": "The Condensed Figure Rule",
        "body": "Any number that is the point of its block is Saira Condensed 800. Running text never is.",
        "section": "typography"
      },
      {
        "name": "The Flat Panel Rule",
        "body": "Panels, bug, tally, plate, buttons and tables carry no shadow. Only a floating layer that overlaps content may take the Popover shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** put the week's headline figures in the score bug or a tally strip, condensed 800 on the bug colour.",
      "**Do** reference role tokens (shell, bat, proj, action, bug and their inks) so all four kits and both modes work unchanged.",
      "**Do** keep panels flat and square with a 1px rule; reserve the Popover shadow for layers that float over content.",
      "**Do** give every status a shape cue as well as a colour (square, hollow ring, round dot, \"behind\" suffix).",
      "**Do** use a single Action Yellow plate or button per view for the primary action."
    ],
    "donts": [
      "**Don't** build a grid of same-size KPI cards over a line chart; that is what the bug replaces.",
      "**Don't** hard-code a kit hex in a component or assume white text on bat.",
      "**Don't** add shadows, gradients or radii above 2px to panels, buttons or the bug.",
      "**Don't** set running text in Saira Condensed or uppercase; condensed uppercase is for figures, headings, labels and buttons."
    ]
  }
}