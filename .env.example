# Investor Outreach secrets and settings. Never commit this file (it is git-ignored).
# For Vercel or any other host, copy each line into the host's environment variables.

# MongoDB Atlas (shared cluster). Only the email hashmap is stored, in MONGODB_DB.
MONGODB_URI=
MONGODB_DB=investor_hub
MONGODB_CEILING_MB=450

# Google service account used to read the sheets (read-only scope).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Spreadsheets the hub reads
SHEET_TRACKER_ID=
# Only the Email List tab of the Investor Tracker (the gid in its link)
SHEET_TRACKER_TAB_IDS=
SHEET_DATABASE_ID=
SHEET_LEADS_ID=
SHEET_USERS_ID=

# Signs login sessions. Changing it signs everyone out.
SESSION_SECRET=
